    {
      "name": "Ingredients",
      "item": [
        {
          "name": "List Ingredients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a list of ingredients', () => {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;\r\n});\r\n\r\nconst items = pm.response.json();\r\nconst idByName = Object.fromEntries(items.map((i) => [i.name, i.id]));\r\n\r\npm.environment.set('eggId', idByName.egg);\r\npm.environment.set('butterId', idByName.butter);\r\npm.environment.set('breadId', idByName.bread);\r\npm.environment.set('cheeseId', idByName.cheese);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ingredients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingredients"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Match recipes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and an array', () => {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(pm.response.json()).to.be.an('array');\r\n});\r\n\r\npm.test('Scrambled eggs ranks first', () => {\r\n    pm.expect(pm.response.json()[0].title).to.eql('Scrambled eggs');\r\n});\r\n\r\npm.test('missing count matches the totals', () => {\r\n    pm.response.json().forEach((r) => {\r\n    pm.expect(r.totalCount - r.matchedCount).to.eql(r.missingIngredients.length);\r\n    });\r\n});\r\n\r\npm.environment.set('adhocMatches', JSON.stringify(pm.response.json()));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/match?ingredients={{eggId}},{{butterId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "match"
              ],
              "query": [
                {
                  "key": "ingredients",
                  "value": "{{eggId}},{{butterId}}"
                },
                {
                  "key": "maxMissing",
                  "value": "2",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get recipe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Grilled cheese with its ingredients', () => {     \r\n    pm.response.to.have.status(200);\r\n    const recipe = pm.response.json();\r\n    pm.expect(recipe.title).to.eql('Grilled cheese');\r\n    pm.expect(recipe.ingredients).to.have.members(['bread', 'butter' ,'cheese']);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
